@{
    var success = TempData["Success"] ?? ViewBag.Success;
    var error = TempData["Error"] ?? ViewBag.Error;
    var info = TempData["Info"] ?? ViewBag.Info;
}

@if (success != null)
{
    <div class="alert alert-success alert-dismissible fade show cmcs-flash" role="alert" data-cmcs-autodismiss="true">
        <i class="fas fa-check-circle me-2" aria-hidden="true"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (error != null)
{
    <div class="alert alert-danger alert-dismissible fade show cmcs-flash" role="alert">
        <i class="fas fa-exclamation-circle me-2" aria-hidden="true"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (info != null)
{
    <div class="alert alert-info alert-dismissible fade show cmcs-flash" role="alert" data-cmcs-autodismiss="true">
        <i class="fas fa-info-circle me-2" aria-hidden="true"></i>@info
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
