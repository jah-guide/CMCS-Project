@using Microsoft.AspNetCore.Identity
@using ContractMonthlyClaimSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-sm-center gap-sm-1">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link py-1 small opacity-75">
                <i class="fas fa-user-circle me-1" aria-hidden="true"></i>
                @UserManager.GetUserName(User)
            </span>
        </li>
        <li class="nav-item">
            <a class="nav-link py-1" asp-area="Identity" asp-page="/Account/Manage/Index" title="Account settings">
                Account
            </a>
        </li>
        <li class="nav-item">
            <form id="logoutForm" class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="nav-link btn btn-link border-0 px-2">
                    Sign out
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link btn btn-sm btn-outline-light ms-sm-1" id="login" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
        </li>
    }
</ul>
