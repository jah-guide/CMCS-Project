@model ContractMonthlyClaimSystem.Models.Claim

@using ContractMonthlyClaimSystem.Models
@{
    ViewData["Title"] = "Claim details";
    var breadcrumbs = new List<BreadcrumbItem>
    {
        new() { Label = "Home", Url = Url.Action("Index", "Home") },
        new() { Label = $"Claim #{Model.ClaimID}" }
    };
}

<partial name="_Breadcrumbs" model="breadcrumbs" />

<div class="cmcs-page-header">
    <h2><i class="fas fa-file-alt me-2" aria-hidden="true"></i>Claim #@Model.ClaimID</h2>
    <p class="cmcs-lead">Full submission, documents, and audit trail for this claim.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="cmcs-card card">
            <div class="card-header">
                <h5 class="mb-0">Claim information</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Claim ID:</dt>
                    <dd class="col-sm-8">@Model.ClaimID</dd>

                    <dt class="col-sm-4">Lecturer:</dt>
                    <dd class="col-sm-8">@Model.User?.FullName</dd>

                    <dt class="col-sm-4">Hours Worked:</dt>
                    <dd class="col-sm-8">@Model.HoursWorked</dd>

                    <dt class="col-sm-4">Total Amount:</dt>
                    <dd class="col-sm-8">R @Model.TotalAmount.ToString("F2")</dd>

                    <dt class="col-sm-4">Submission Date:</dt>
                    <dd class="col-sm-8">@Model.SubmissionDate.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4">Current status:</dt>
                    <dd class="col-sm-8">
                        <partial name="_ClaimStatusBadge" model="@Model.CurrentStatus?.StatusName" />
                    </dd>

                    <dt class="col-sm-4">Notes:</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Notes) ? "No notes" : Model.Notes)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="cmcs-card card">
            <div class="card-header">
                <h5 class="mb-0">Supporting documents</h5>
            </div>
            <div class="card-body">
                @if (Model.SupportingDocuments?.Any() == true)
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var doc in Model.SupportingDocuments)
                        {
                            <li class="list-group-item px-0">
                                <i class="fas fa-file me-1" aria-hidden="true"></i> @doc.FileName
                                <small class="text-muted">(Uploaded: @doc.UploadDate.ToString("yyyy-MM-dd"))</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <partial name="_EmptyState" model='new ContractMonthlyClaimSystem.Models.EmptyStateViewModel {
                        Title = "No documents",
                        Message = "This claim was submitted without supporting files.",
                        IconClass = "fa-paperclip"
                    }' />
                }
            </div>
        </div>

        <div class="cmcs-card card mt-3">
            <div class="card-header">
                <h5 class="mb-0">Status history</h5>
            </div>
            <div class="card-body">
                @if (Model.StatusHistory?.Any() == true)
                {
                    <div class="timeline">
                        @foreach (var history in Model.StatusHistory.OrderBy(h => h.ChangeDate))
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker"></div>
                                <div class="timeline-content">
                                    <partial name="_ClaimStatusBadge" model="@history.Status?.StatusName" />
                                    <br />
                                    <small>By: @history.ChangedByUser?.FullName</small>
                                    <br />
                                    <small>Date: @history.ChangeDate.ToString("yyyy-MM-dd HH:mm")</small>
                                    @if (!string.IsNullOrEmpty(history.Notes))
                                    {
                                        <br />
                                        <small>Note: @history.Notes</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No status history available.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <partial name="_ClaimStatusLegend" />
</div>

<div class="mt-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary">Back</a>
</div>

<style>
    .timeline {
        border-left: 2px solid var(--cmcs-navy, #1e3a5f);
        padding-left: 15px;
    }
    .timeline-item {
        margin-bottom: 15px;
        position: relative;
    }
    .timeline-marker {
        position: absolute;
        left: -20px;
        top: 5px;
        width: 10px;
        height: 10px;
        background: var(--cmcs-navy, #1e3a5f);
        border-radius: 50%;
    }
</style>
